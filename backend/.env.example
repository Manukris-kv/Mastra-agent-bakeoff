LITELLM_BASE_URL=https://your-litellm-proxy
LITELLM_API_KEY=your-api-key
# SSE URL of the agent-sdk-bakeoff-mcp-server (../agent-sdk-bakeoff-mcp-server,
# run via `docker compose up --build`) — defaults to http://localhost:8081/sse
PULSE_MCP_URL=http://localhost:8081/sse

# Silences Mastra's anonymous CLI usage telemetry (PostHog) — purely cosmetic
# otherwise ("PostHogFetchNetworkError" noise in offline/restricted-network envs),
# unrelated to agent/MCP/model behavior.
MASTRA_TELEMETRY_DISABLED=1

# Postgres storage (docker-compose.yml) — main Mastra storage + agent memory.
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/mastra

# Your Jira's actual current sprint name (sprint-prep-workflow.ts) — the MCP
# server has no way to resolve "the current sprint" itself. Leave unset to
# skip the sprint filter (falls back to open/recently-updated tickets).
JIRA_CURRENT_SPRINT=